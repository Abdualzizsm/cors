# ملف إعدادات البيئة للإنتاج
# انسخ هذا الملف إلى .env وأضف القيم الفعلية

# مفتاح Google Gemini API (مطلوب)
GEMINI_API_KEY=your_actual_api_key_here

# إعدادات Flask
FLASK_ENV=production
FLASK_DEBUG=false

# إعدادات الخادم
PORT=5000
HOST=0.0.0.0

# إعدادات الأمان (اختيارية)
SECRET_KEY=your_secret_key_for_sessions